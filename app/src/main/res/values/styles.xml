<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- etiqueta só de leitura, sem clique, usada nos cartões de evento -->
    <style name="Widget.CampusHub.EventChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- linha com ícone e texto na tela de detalhes -->
    <style name="Widget.CampusHub.InfoRow" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="drawableTint">?attr/colorPrimary</item>
    </style>
</resources>
