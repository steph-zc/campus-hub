<?xml version="1.0" encoding="utf-8"?>
<!-- foto ou vídeo em tela cheia, sobre fundo preto nos dois temas -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/imgFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/media_full_screen"
        android:scaleType="fitCenter" />

    <!-- só nos vídeos; ocupa o máximo da tela sem distorcer, e os controles aparecem ao tocar -->
    <VideoView
        android:id="@+id/videoFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/media_full_screen"
        android:visibility="gone" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#66000000"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.CampusHub.Popup" />

</FrameLayout>
