<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimarySurface"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:popupTheme="@style/ThemeOverlay.CampusHub.Popup"
            app:title="@string/event_details" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- etiquetas, título e informações principais -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCourse"
                            style="@style/Widget.CampusHub.EventChip"
                            android:textColor="@color/chip_course_text"
                            app:chipBackgroundColor="@color/chip_course_bg"
                            app:chipIcon="@drawable/ic_school"
                            app:chipIconTint="@color/chip_course_text" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAccess"
                            style="@style/Widget.CampusHub.EventChip" />

                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/txtCategory"
                        style="@style/Widget.CampusHub.CategoryLabel"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDate"
                        style="@style/Widget.CampusHub.InfoRow"
                        app:drawableStartCompat="@drawable/ic_event" />

                    <TextView
                        android:id="@+id/txtTime"
                        style="@style/Widget.CampusHub.InfoRow"
                        app:drawableStartCompat="@drawable/ic_schedule" />

                    <TextView
                        android:id="@+id/txtLocation"
                        style="@style/Widget.CampusHub.InfoRow"
                        app:drawableStartCompat="@drawable/ic_place" />

                    <TextView
                        android:id="@+id/txtCapacity"
                        style="@style/Widget.CampusHub.InfoRow"
                        app:drawableStartCompat="@drawable/ic_people" />

                    <!-- média das notas; só aparece em eventos encerrados -->
                    <TextView
                        android:id="@+id/txtRatingAverage"
                        style="@style/Widget.CampusHub.InfoRow"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_star"
                        app:drawableTint="@color/ui_accent" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- aparece só para quem já está inscrito -->
            <TextView
                android:id="@+id/txtEnrolled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_enrolled_banner"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/enrolled_banner"
                android:textColor="@color/chip_open_text"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_check_circle"
                app:drawableTint="@color/chip_open_text" />

            <!-- só um dos dois botões fica visível, conforme o aluno está inscrito ou não -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnroll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/enroll"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEnrollment"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/cancel_enrollment"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <!-- só aparece para quem estava inscrito, depois que o evento termina -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_rating"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- stepSize 1 = só notas inteiras, de 1 a 5 -->
                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:numStars="5"
                        android:progressBackgroundTint="?android:attr/textColorSecondary"
                        android:progressTint="@color/ui_accent"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/txtRatingHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/rating_hint" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- descrição completa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_event"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- comentários: campo para escrever e lista, do mais novo para o mais antigo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtCommentsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comments"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- o ícone de enviar fica dentro do próprio campo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutComment"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/write_comment"
                        app:counterEnabled="true"
                        app:counterMaxLength="500"
                        app:endIconContentDescription="@string/send_comment"
                        app:endIconDrawable="@drawable/ic_send"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:maxLines="5" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtNoComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="@string/no_comments"
                        android:visibility="gone" />

                    <!-- dentro da rolagem da tela, a lista mostra todos os itens de uma vez -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
