<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- o mapa baixa os pedaços do OpenStreetMap pela internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusHub">

        <activity
            android:name=".ui.auth.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.RegisterActivity" />

        <activity android:name=".ui.auth.LoginActivity" />

        <!-- adjustResize: o teclado não empurra a janela; o app reserva o espaço dele (ScreenSetup) -->
        <activity
            android:name=".ui.events.EventsActivity"
            android:theme="@style/Theme.CampusHub.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.details.EventDetailsActivity"
            android:theme="@style/Theme.CampusHub.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.events.MyEventsActivity"
            android:theme="@style/Theme.CampusHub.NoActionBar" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:theme="@style/Theme.CampusHub.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.media.MediaViewerActivity"
            android:theme="@style/Theme.CampusHub.NoActionBar" />

        <!-- entrega à câmera um endereço content:// para ela gravar a foto na pasta do app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>